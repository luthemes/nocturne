{
	"$schema": "https://raw.githubusercontent.com/techkodeninja/chassis/develop/schemas/chassis.schema.json",
	"settings": {
		"palette": {
			"night": "#0b0d12",
			"ink":   "#0f1117",
			"slate": "#161a23",
			"steel": "#1c2130",
			"line":  "#2d3446",
			"snow":  "#ffffff",
			"mist":  "#d7dae0",
			"fog":   "#9aa3b2",
			"blue":  "#7c9cff",
			"sky":   "#9db4ff",
			"ice":   "#c7d4ff"
		},
		"font": {
			"body":    "'Merriweather', serif",
			"heading": "'Fira Sans', sans-serif",
			"code":    "'JetBrains Mono', monospace"
		},
		"layout": {
			"width":   "75rem",
			"sidebar": "20rem"
		}
	},
	"styles": {
		"color": {
			"background":  "@ink",
			"text":        "@mist",
			"muted":       "@fog",
			"divider":     "@line",
			"alt":         "@steel",
			"accent":      "@blue",
			"accent-text": "@night"
		},
		"elements": {
			"link": {
				"color": { "text": "@sky" },
				":hover": { "color": { "text": "@ice" } }
			},
			"heading": {
				"color": { "text": "@snow" }
			}
		},
		"header": {
			"color": { "background": "@night", "text": "@snow" },
			"spacing": { "padding": "s" }
		},
		"primary-menu": {
			"link": { "spacing": { "padding": "xs m" } }
		},
		"menu-button": {
			"position": "bottom-left",
			"color": { "text": "@snow" },
			"border": { "color": "@snow" },
			"spacing": { "padding": "5px 10px" }
		},
		"content": {
			"spacing": { "padding": "l", "gap": "l" }
		},
		"post": {
			"color": { "background": "@slate" },
			"border": { "color": "@line" }
		},
		"widget": {
			"color": { "background": "@slate", "text": "@mist" },
			"border": { "color": "@line" },
			"title": { "color": { "text": "@snow" } }
		},
		"comments": {
			"color": { "background": "@slate" },
			"border": { "color": "@line" },
			"spacing": { "padding": "l", "margin": "l" },
			"meta": { "spacing": { "margin": "l" } }
		},
		"footer": {
			"color": { "background": "@night", "text": "@snow" }
		}
	}
}
