{
    "name": "luthemes/nocturne",
    "type": "classicpress-theme",
    "description": "Nocturne is a dark theme for ClassicPress, built on Chassis.",
    "keywords": [
        "classicpress",
        "theme"
    ],
    "homepage": "https://luthemes.com/portfolio/nocturne",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Benjamin Lu",
            "email": "benlumia007@gmail.com",
            "homepage": "https://luthemes.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nocturne\\": "app"
        }
    },
    "require": {
        "php": ">=7.4",
        "backdrop-dev/framework": "^1.0.1",
        "backdrop-dev/fonts": "^1.0.2",
        "techkodeninja/chassis": "^0.1.7"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "wp-coding-standards/wpcs": "^3.4.1",
        "php-parallel-lint/php-parallel-lint": "*"
    },
    "scripts": {
        "lint:cpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs .",
        "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
        "rename": "@php bin/rename.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts-descriptions": {
        "rename": "Rename the theme using themerename.json. Add -- --dry-run to preview."
    }
}
